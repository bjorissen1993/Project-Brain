# PostgreSQL connection (local Docker: docker compose up -d)
DATABASE_URL="postgresql://projectbrain:projectbrain@localhost:5432/projectbrain?schema=public"

# OpenAI — server-only. Never expose to the client.
# - Setup wizard: suggestSetupFromIntent (heuristic fallback if empty)
# - Ready analysis: classify/summarize (deferred if empty — not faked as AI)
# - Project chat: standard tier; deferred message if empty (messages still persist)
OPENAI_API_KEY=""
OPENAI_MODEL_QUICK="gpt-4o-mini"
OPENAI_MODEL_STANDARD="gpt-4o"
OPENAI_MODEL_DEEP="gpt-4o"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5) — leave empty for local anonymous workspace.
# When AUTH_SECRET + at least one provider are set, the app requires sign-in.
# Production URL: https://brain.freakydev.com
# -----------------------------------------------------------------------------
AUTH_SECRET=""
# Public site URL (Auth.js also accepts NEXTAUTH_URL).
# Local: http://localhost:3000
# Production: MUST be https://brain.freakydev.com (Google OAuth rejects plain HTTP).
AUTH_URL="http://localhost:3000"
# Behind Coolify / nginx / Cloudflare reverse proxy:
AUTH_TRUST_HOST="true"

# Google OAuth (Google Cloud Console → OAuth client)
# Production origin: https://brain.freakydev.com
# Production redirect (exact): https://brain.freakydev.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth App (GitHub → Settings → Developer settings → OAuth Apps)
# Authorization callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Single-user / invite allowlist (comma-separated, case-insensitive).
# Sign-in is denied if the user matches neither list. Both empty = deny all.
ALLOWED_EMAILS="you@example.com"
ALLOWED_GITHUB_USERS="your-github-username"
